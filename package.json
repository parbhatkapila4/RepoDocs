{
  "name": "repodoc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --turbopack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "prepare": "node -e \"try { require.resolve('husky'); require('child_process').execSync('husky install', { stdio: 'inherit' }); } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e; }\"",
    "validate": "npm run type-check && npm run lint && npm run test:ci",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.31.10",
    "@google/genai": "^1.19.0",
    "@hookform/resolvers": "^5.2.1",
    "@langchain/community": "^0.3.55",
    "@langchain/core": "^0.3.75",
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.9.0",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.12",
    "next": "16.0.7",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.3",
    "prisma": "^6.16.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^9.0.1",
    "react-redux": "^9.2.0",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.0",
    "resend": "^6.0.2",
    "sonner": "^2.0.7",
    "svix": "^1.76.1",
    "tailwind-merge": "^3.3.1",
    "tar-stream": "^3.2.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@types/tar-stream": "^3.1.4",
    "baseline-browser-mapping": "^2.11.15",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  }
}
