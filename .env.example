# ─── Database ──────────────────────────────────────────────
# Postgres with the pgvector extension enabled.
DATABASE_URL="postgresql://user:password@localhost:5432/repodoc"
# Direct connection (bypasses pooling) for migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/repodoc"

# ─── Auth (Clerk) ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ─── AI ────────────────────────────────────────────────────
# Google's API, called directly for embeddings only
# (gemini-embedding-001, 768 dimensions).
GEMINI_API_KEY=
# The single gateway for ALL text generation - chat, README, docs.
# Models are picked per task, not raced; there is no cross-provider failover.
OPENROUTER_API_KEY=
# Optional per-task model overrides (OpenRouter model ids). Defaults live in
# src/lib/gemini.ts. Pick models whose max completion tokens fit the task -
# docs generation emits up to ~20k tokens per chunk.
OPENROUTER_DOCS_MODEL=
OPENROUTER_DOCS_MODIFY_MODEL=
OPENROUTER_README_MODEL=

# ─── GitHub ────────────────────────────────────────────────
# Personal access token for higher GitHub API rate limits and
# private-repo access. Optional - public repos work without it.
GITHUB_TOKEN=

# ─── Payments (Gumroad) ────────────────────────────────────
# Shared secret embedded in the Gumroad "Ping" URL configured in
# Settings → Advanced → Ping:
#   https://YOUR_DOMAIN/api/gumroad-webhook?secret=<this value>
GUMROAD_WEBHOOK_SECRET=
# Optional. Defaults match the URLs hardcoded in src/app/pricing/page.tsx
# (the suffix after `/l/` in your Gumroad product URLs). Override only if
# you create new products.
GUMROAD_PROFESSIONAL_PERMALINK=
GUMROAD_ENTERPRISE_PERMALINK=

# ─── Security ──────────────────────────────────────────────
# 32-byte key encrypting stored GitHub tokens (AES-256-GCM).
# WITHOUT IT, TOKENS ARE STORED IN PLAINTEXT - the code falls back
# rather than failing, so set this in every environment.
ENCRYPTION_KEY=
# Shared secret authorizing the indexing-worker cron route.
CRON_SECRET=

# ─── Contact form (Resend) ─────────────────────────────────
# Without this key, POST /api/contact returns 503 and the form shows a
# real error plus the direct email address. It never reports a false send.
RESEND_API_KEY=
# Where contact submissions are delivered.
# Optional - defaults to parbhat@parbhat.work.
CONTACT_TO_EMAIL=
# Sender address. Optional - defaults to onboarding@resend.dev, which needs
# no domain verification but ONLY delivers to the address registered on your
# Resend account. For delivery anywhere else, verify a domain in Resend and
# point this at it (e.g. contact@yourdomain.com).
CONTACT_FROM_EMAIL=

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional ──────────────────────────────────────────────
# Upstash Redis used for distributed locking. Falls back to
# in-process locking when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
